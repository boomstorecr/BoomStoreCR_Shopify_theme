{%- liquid
  assign color_scheme = section.settings.color_scheme
-%}
<header class="site-header color-{{ color_scheme }}{% if section.settings.sticky %} site-header--sticky{% endif %}" data-section-id="{{ section.id }}" data-section-type="header">
  <div class="site-header__container page-width">
    <button class="site-header__menu-toggle" type="button" aria-expanded="false" aria-controls="MobileNav" data-mobile-nav-toggle>
      <span class="visually-hidden">{{ 'header.menu' | t }}</span>
      <span class="icon-bar"></span>
      <span class="icon-bar"></span>
      <span class="icon-bar"></span>
    </button>

    <a href="{{ routes.root_url }}" class="site-header__logo">
      {%- if section.settings.logo != blank -%}
        <img
          src="{{ section.settings.logo | image_url: width: 300 }}"
          alt="{{ shop.name }}"
          width="{{ section.settings.logo_width }}"
          style="width: {{ section.settings.logo_width }}px;"
          loading="eager"
        >
      {%- else -%}
        <span class="site-header__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <nav class="site-header__nav" aria-label="{{ 'header.menu' | t }}">
      <ul class="site-header__menu">
        {%- for link in section.settings.menu.links -%}
          <li class="site-header__menu-item{% if link.links != blank %} has-dropdown{% endif %}">
            <a href="{{ link.url }}" class="site-header__menu-link"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
            {%- if link.links != blank -%}
              <ul class="site-header__submenu">
                {%- for childlink in link.links -%}
                  <li><a href="{{ childlink.url }}">{{ childlink.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="site-header__icons">
      <a href="{{ routes.search_url }}" class="site-header__icon-link" aria-label="{{ 'header.search' | t }}">
        {%- render 'icon', icon: 'search' -%}
      </a>
      <a href="{{ routes.account_url }}" class="site-header__icon-link" aria-label="{{ 'header.account' | t }}">
        {%- render 'icon', icon: 'account' -%}
      </a>
      <a href="{{ routes.cart_url }}" class="site-header__icon-link site-header__cart-link" aria-label="{{ 'header.cart' | t }}">
        {%- render 'icon', icon: 'cart' -%}
        <span class="site-header__cart-count" data-cart-count>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  <nav id="MobileNav" class="mobile-nav" aria-hidden="true">
    <ul class="mobile-nav__menu">
      {%- for link in section.settings.menu.links -%}
        <li>
          <a href="{{ link.url }}">{{ link.title }}</a>
          {%- if link.links != blank -%}
            <ul class="mobile-nav__submenu">
              {%- for childlink in link.links -%}
                <li><a href="{{ childlink.url }}">{{ childlink.title }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </nav>
</header>

{% schema %}
{
  "name": "t:sections.header.name",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "t:sections.header.settings.logo.label" },
    { "type": "range", "id": "logo_width", "min": 60, "max": 260, "step": 10, "default": 140, "label": "t:sections.header.settings.logo_width.label" },
    { "type": "link_list", "id": "menu", "default": "main-menu", "label": "t:sections.header.settings.menu.label" },
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-light", "label": "t:sections.header.settings.color_scheme.label" },
    { "type": "checkbox", "id": "sticky", "default": true, "label": "t:sections.header.settings.sticky.label" }
  ],
  "default": {
    "settings": {
      "logo_width": 140,
      "menu": "main-menu",
      "color_scheme": "scheme-light",
      "sticky": true
    }
  }
}
{% endschema %}
