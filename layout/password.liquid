<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name }}</title>
  {{ 'base.css' | asset_url | stylesheet_tag }}

  {%- style -%}
    {%- for scheme in settings.color_schemes -%}
      .color-{{ scheme.id }} {
        --color-background: {{ scheme.settings.background }};
        --color-text: {{ scheme.settings.text }};
        --color-button: {{ scheme.settings.button }};
        --color-button-label: {{ scheme.settings.button_label }};
        --color-secondary-button: {{ scheme.settings.secondary_button }};
        --color-secondary-button-label: {{ scheme.settings.secondary_button_label }};
        --color-border: {{ scheme.settings.border }};
        --color-sale-badge: {{ scheme.settings.sale_badge }};
        --color-sale-badge-text: {{ scheme.settings.sale_badge_text }};
        background-color: var(--color-background);
        color: var(--color-text);
      }
    {%- endfor -%}
  {%- endstyle -%}

  {{ content_for_header }}
</head>
<body class="password-page color-scheme-dark">
  <div class="password-page__content page-width" style="padding: 80px 20px; text-align: center;">
    <h1>{{ shop.name }}</h1>

    {%- if password_insufficient? -%}
      <p class="password-page__error">{{ 'general.password_page.wrong_password' | t }}</p>
    {%- endif -%}

    {%- form 'storefront_password' -%}
      <label for="Password" class="visually-hidden">{{ 'general.password_page.password' | t }}</label>
      <input type="password" name="password" id="Password" placeholder="{{ 'general.password_page.password' | t }}" required>
      <button type="submit" class="button button--primary">{{ 'general.password_page.enter' | t }}</button>
    {%- endform -%}

    {{ content_for_layout }}
  </div>
</body>
</html>