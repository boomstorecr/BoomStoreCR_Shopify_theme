{{ 'section-product-showcase.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign secondary_images = product.images | slice: 1, 3
  assign facts = 'cantidad_de_jugadores|players|icon-account.svg,idioma|language|icon-chat-bubble.svg,tipo_de_juego|game_type|icon-box.svg,categorias|categories|icon-price-tag.svg,mecanicas_de_juego|mechanics|icon-info.svg,edad_minima|minimum_age|icon-warning.svg,minimo_de_jugadores|minimum_players|icon-plus.svg,disenador_del_juego|designer|icon-star.svg' | split: ','
  assign has_facts = false
  for fact_definition in facts
    assign fact_parts = fact_definition | split: '|'
    assign fact = product.metafields.custom[fact_parts[0]]
    if fact != blank and fact.value != blank
      assign has_facts = true
    endif
  endfor
-%}

{%- if secondary_images.size > 0 and has_facts -%}
  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }
    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}
  <section class="product-showcase color-{{ section.settings.color_scheme }} gradient">
    <div class="product-showcase__inner page-width section-{{ section.id }}-padding">
      <div class="product-showcase__media">
        {%- for image in secondary_images -%}
          <div class="product-showcase__image">
            {{
              image
              | image_url: width: 1200
              | image_tag:
                widths: '375, 550, 750, 990, 1200',
                sizes: '(min-width: 990px) 38vw, 100vw',
                loading: 'lazy',
                alt: image.alt | default: product.title
            }}
          </div>
        {%- endfor -%}
      </div>

      <div class="product-showcase__details">
        <h2 class="title inline-richtext {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
        <dl class="product-showcase__facts">
          {%- for fact_definition in facts -%}
            {%- assign fact_parts = fact_definition | split: '|' -%}
            {%- assign fact = product.metafields.custom[fact_parts[0]] -%}
            {%- if fact != blank and fact.value != blank -%}
              <div class="product-showcase__fact">
                <dt>
                  <span class="svg-wrapper" aria-hidden="true">{{ fact_parts[2] | inline_asset_content }}</span>
                  {{ 'sections.game_details.facts.' | append: fact_parts[1] | t }}
                </dt>
                <dd>
                  {%- if fact.type contains 'list' -%}
                    {{ fact.value | join: ', ' | escape }}
                  {%- else -%}
                    {{ fact.value | escape }}
                  {%- endif -%}
                </dd>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </dl>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.product_showcase.name",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "t:sections.product_showcase.settings.heading.default",
      "label": "t:sections.product_showcase.settings.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "t:sections.all.heading_size.options__1.label" },
        { "value": "h1", "label": "t:sections.all.heading_size.options__2.label" }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "t:sections.all.colors.label"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36,
      "label": "t:sections.all.padding.padding_top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36,
      "label": "t:sections.all.padding.padding_bottom"
    }
  ],
  "presets": [{ "name": "t:sections.product_showcase.name" }]
}
{% endschema %}