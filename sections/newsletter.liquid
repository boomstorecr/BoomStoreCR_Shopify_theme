<section class="newsletter color-{{ section.settings.color_scheme }} section-padding" data-section-id="{{ section.id }}" data-section-type="newsletter">
  <div class="page-width newsletter__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="section-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="newsletter__text">{{ section.settings.text }}</p>
    {%- endif -%}

    {%- form 'customer' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="newsletter__form-row">
        <label for="NewsletterEmail-{{ section.id }}" class="visually-hidden">{{ 'general.newsletter.email_placeholder' | t }}</label>
        <input
          type="email"
          name="contact[email]"
          id="NewsletterEmail-{{ section.id }}"
          class="newsletter__input"
          placeholder="{{ 'general.newsletter.email_placeholder' | t }}"
          required
        >
        <button type="submit" class="button button--secondary newsletter__submit">{{ 'general.newsletter.submit' | t }}</button>
      </div>
      {%- if form.posted_successfully? -%}
        <p class="newsletter__success">{{ 'general.newsletter.success' | t }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "settings": [
    { "type": "text", "id": "heading", "default": "Únete a nuestra comunidad", "label": "t:sections.newsletter.settings.heading.label" },
    { "type": "textarea", "id": "text", "default": "Recibe noticias, ofertas y lanzamientos directamente en tu correo.", "label": "t:sections.newsletter.settings.text.label" },
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-dark", "label": "t:sections.newsletter.settings.color_scheme.label" }
  ],
  "presets": [
    {
      "name": "t:sections.newsletter.presets.name",
      "settings": { "heading": "Únete a nuestra comunidad", "color_scheme": "scheme-dark" }
    }
  ]
}
{% endschema %}
