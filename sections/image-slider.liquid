<section
  class="image-slider color-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  data-section-type="image-slider"
  data-image-slider
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
  style="--image-slider-height: {{ section.settings.height }}px; --image-slider-mobile-height: {{ section.settings.mobile_height }}px; --image-slider-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
>
  <div class="image-slider__viewport">
    <div class="image-slider__track" data-image-slider-track>
      {%- for block in section.blocks -%}
        {%- liquid
          assign slide_url = block.settings.link
          if block.settings.product != blank
            assign slide_url = block.settings.product.url
          elsif block.settings.collection != blank
            assign slide_url = block.settings.collection.url
          endif
          assign slide_image = block.settings.image
          if slide_image == blank
            assign slide_image = block.settings.mobile_image
          endif
        -%}
        <article class="image-slider__slide" data-image-slider-slide {{ block.shopify_attributes }}>
          {%- if slide_url != blank -%}<a href="{{ slide_url }}" class="image-slider__link">{%- endif -%}
            <div class="image-slider__media">
              {%- if slide_image != blank -%}
                <picture>
                  {%- if block.settings.mobile_image != blank -%}
                    <source media="(max-width: 749px)" srcset="{{ block.settings.mobile_image | image_url: width: 900 }}">
                  {%- endif -%}
                  <img
                    src="{{ slide_image | image_url: width: 1800 }}"
                    srcset="{{ slide_image | image_url: width: 900 }} 900w, {{ slide_image | image_url: width: 1400 }} 1400w, {{ slide_image | image_url: width: 1800 }} 1800w"
                    sizes="100vw"
                    alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
                    width="{{ slide_image.width }}"
                    height="{{ slide_image.height }}"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  >
                </picture>
              {%- else -%}
                <div class="image-slider__placeholder"></div>
              {%- endif -%}
            </div>
            {%- if block.settings.heading != blank or block.settings.text != blank or block.settings.button_label != blank -%}
              <div class="image-slider__content image-slider__content--{{ section.settings.text_alignment }} page-width">
                {%- if block.settings.heading != blank -%}<h2>{{ block.settings.heading }}</h2>{%- endif -%}
                {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
                {%- if block.settings.button_label != blank -%}<span class="button button--primary">{{ block.settings.button_label }}</span>{%- endif -%}
              </div>
            {%- endif -%}
          {%- if slide_url != blank -%}</a>{%- endif -%}
        </article>
      {%- endfor -%}
    </div>

    {%- if section.settings.show_arrows and section.blocks.size > 1 -%}
      <button type="button" class="image-slider__arrow image-slider__arrow--prev" data-image-slider-prev aria-label="Previous slide">&#8592;</button>
      <button type="button" class="image-slider__arrow image-slider__arrow--next" data-image-slider-next aria-label="Next slide">&#8594;</button>
    {%- endif -%}

    {%- if section.settings.show_dots and section.blocks.size > 1 -%}
      <div class="image-slider__dots" data-image-slider-dots aria-label="Slide navigation">
        {%- for block in section.blocks -%}
          <button type="button" class="image-slider__dot{% if forloop.first %} is-active{% endif %}" data-image-slider-dot="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"{% unless forloop.first %} aria-current="false"{% else %} aria-current="true"{% endunless %}></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Image slider",
  "settings": [
    { "type": "range", "id": "height", "min": 300, "max": 760, "step": 20, "default": 520, "label": "Desktop height" },
    { "type": "range", "id": "mobile_height", "min": 220, "max": 600, "step": 20, "default": 420, "label": "Mobile height" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 80, "step": 5, "default": 30, "label": "Overlay opacity" },
    { "type": "select", "id": "text_alignment", "default": "center", "label": "Text alignment", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" },
      { "value": "right", "label": "Right" }
    ] },
    { "type": "checkbox", "id": "show_arrows", "default": true, "label": "Show arrows" },
    { "type": "checkbox", "id": "show_dots", "default": true, "label": "Show dots" },
    { "type": "checkbox", "id": "autoplay", "default": true, "label": "Enable autoplay" },
    { "type": "range", "id": "autoplay_speed", "min": 3, "max": 10, "step": 1, "default": 5, "label": "Autoplay speed" },
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-dark", "label": "Color scheme" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Desktop image" },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "product", "id": "product", "label": "Product link" },
        { "type": "collection", "id": "collection", "label": "Collection link" },
        { "type": "url", "id": "link", "label": "Other link" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    { "name": "Image slider", "blocks": [{ "type": "slide" }] }
  ]
}
{% endschema %}