<div class="error-section color-scheme-light section-padding">
  <div class="page-width error-section__content">
    <h1 class="error-section__title">{{ 'general.404.title' | t }}</h1>
    <p class="error-section__text">{{ 'general.404.subtext' | t }}</p>
    <a href="{{ routes.root_url }}" class="button button--primary">{{ 'general.404.link' | t }}</a>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-404.name",
  "settings": []
}
{% endschema %}
