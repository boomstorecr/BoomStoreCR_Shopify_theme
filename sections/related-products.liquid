{%- assign related_products = product.metafields.custom.productos_relacionados.value -%}

{%- if related_products != blank -%}
  {%- assign related_count = 0 -%}
  {%- capture related_product_cards -%}
    {%- for related_product in related_products limit: 8 -%}
      {%- unless related_product.id == product.id -%}
        <li>{%- render 'product-card', product: related_product, enable_quick_add: true -%}</li>
        {%- assign related_count = related_count | plus: 1 -%}
      {%- endunless -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- if related_count > 0 -%}
    <section class="related-products section-padding" data-section-id="{{ section.id }}">
      <div class="page-width">
        <h2 class="section-heading">{{ 'products.product.related_products' | t }}</h2>
        <ul class="product-grid product-grid--4-col">{{ related_product_cards }}</ul>
      </div>
    </section>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Related products",
  "settings": [],
  "presets": [{ "name": "Related products" }]
}
{% endschema %}
