<meta name="description" content="{{ page_description | default: shop.description | escape }}">
<link rel="canonical" href="{{ canonical_url }}">
{%- if request.page_type == 'product' -%}
  <meta property="og:type" content="product">
{%- else -%}
  <meta property="og:type" content="website">
{%- endif -%}
<meta property="og:title" content="{{ page_title | default: shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:site_name" content="{{ shop.name }}">
{%- if page_description -%}
  <meta property="og:description" content="{{ page_description | escape }}">
{%- endif -%}
{%- if page_image -%}
  <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
