<section class="contact-form color-{{ section.settings.color_scheme }} section-padding" data-section-id="{{ section.id }}" data-section-type="contact-form">
  <div class="page-width">
    <div class="contact-form__container">
      <div class="contact-form__intro">
        {%- if section.settings.heading != blank -%}
          <h2 class="section-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="contact-form__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>

      {%- assign form_id = 'ContactForm-' | append: section.id -%}
      {%- form 'contact', id: form_id, class: 'contact-form__form' -%}
        {%- if form.posted_successfully? -%}
          <div class="contact-form__success" role="status" aria-live="polite">
            <p>{{ 'contact.form.success' | t }}</p>
          </div>
        {%- endif -%}

        {%- if form.errors -%}
          <div class="contact-form__errors" role="alert" aria-live="assertive">
            <p class="contact-form__error-heading">{{ 'contact.form.error_heading' | t }}</p>
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="contact-form__fields">
          <div class="contact-form__field contact-form__field--half">
            <label for="ContactForm-name-{{ section.id }}">
              {{ 'contact.form.name' | t }} <span aria-label="{{ 'contact.form.required' | t }}">*</span>
            </label>
            <input
              type="text"
              id="ContactForm-name-{{ section.id }}"
              name="contact[name]"
              autocomplete="name"
              required
              aria-required="true"
              value="{% if form.name %}{{ form.name }}{% endif %}"
              placeholder="{{ 'contact.form.name_placeholder' | t }}"
            >
          </div>

          <div class="contact-form__field contact-form__field--half">
            <label for="ContactForm-email-{{ section.id }}">
              {{ 'contact.form.email' | t }} <span aria-label="{{ 'contact.form.required' | t }}">*</span>
            </label>
            <input
              type="email"
              id="ContactForm-email-{{ section.id }}"
              name="contact[email]"
              autocomplete="email"
              required
              aria-required="true"
              value="{% if form.email %}{{ form.email }}{% endif %}"
              placeholder="{{ 'contact.form.email_placeholder' | t }}"
            >
          </div>

          {%- if section.settings.show_phone -%}
            <div class="contact-form__field contact-form__field--half">
              <label for="ContactForm-phone-{{ section.id }}">
                {{ 'contact.form.phone' | t }}
              </label>
              <input
                type="tel"
                id="ContactForm-phone-{{ section.id }}"
                name="contact[phone]"
                autocomplete="tel"
                value="{% if form.phone %}{{ form.phone }}{% endif %}"
                placeholder="{{ 'contact.form.phone_placeholder' | t }}"
              >
            </div>
          {%- endif -%}

          {%- if section.settings.show_order_number -%}
            <div class="contact-form__field contact-form__field--half">
              <label for="ContactForm-order-{{ section.id }}">
                {{ 'contact.form.order_number' | t }}
              </label>
              <input
                type="text"
                id="ContactForm-order-{{ section.id }}"
                name="contact[order_number]"
                value="{% if form.order_number %}{{ form.order_number }}{% endif %}"
                placeholder="{{ 'contact.form.order_number_placeholder' | t }}"
              >
            </div>
          {%- endif -%}

          {%- if section.settings.show_topic -%}
            <div class="contact-form__field contact-form__field--full">
              <label for="ContactForm-topic-{{ section.id }}">
                {{ 'contact.form.topic' | t }}
              </label>
              <select
                id="ContactForm-topic-{{ section.id }}"
                name="contact[topic]"
              >
                <option value="">{{ 'contact.form.topic_placeholder' | t }}</option>
                <option value="{{ 'contact.form.topic_general' | t }}">{{ 'contact.form.topic_general' | t }}</option>
                <option value="{{ 'contact.form.topic_order' | t }}">{{ 'contact.form.topic_order' | t }}</option>
                <option value="{{ 'contact.form.topic_product' | t }}">{{ 'contact.form.topic_product' | t }}</option>
                <option value="{{ 'contact.form.topic_other' | t }}">{{ 'contact.form.topic_other' | t }}</option>
              </select>
            </div>
          {%- endif -%}

          <div class="contact-form__field contact-form__field--full">
            <label for="ContactForm-body-{{ section.id }}">
              {{ 'contact.form.message' | t }} <span aria-label="{{ 'contact.form.required' | t }}">*</span>
            </label>
            <textarea
              id="ContactForm-body-{{ section.id }}"
              name="contact[body]"
              rows="6"
              required
              aria-required="true"
              placeholder="{{ 'contact.form.message_placeholder' | t }}"
            >{% if form.body %}{{ form.body }}{% endif %}</textarea>
          </div>
        </div>

        <div class="contact-form__submit">
          <button type="submit" class="button button--primary">
            {{ section.settings.button_label }}
          </button>
        </div>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.contact-form.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Contáctanos",
      "label": "t:sections.contact-form.settings.heading.label"
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "<p>¿Tienes alguna pregunta? Estamos aquí para ayudarte.</p>",
      "label": "t:sections.contact-form.settings.text.label"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Enviar mensaje",
      "label": "t:sections.contact-form.settings.button_label.label"
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "default": true,
      "label": "t:sections.contact-form.settings.show_phone.label"
    },
    {
      "type": "checkbox",
      "id": "show_order_number",
      "default": false,
      "label": "t:sections.contact-form.settings.show_order_number.label"
    },
    {
      "type": "checkbox",
      "id": "show_topic",
      "default": true,
      "label": "t:sections.contact-form.settings.show_topic.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-light",
      "label": "t:sections.contact-form.settings.color_scheme.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact-form.presets.name",
      "settings": {
        "heading": "Contáctanos",
        "color_scheme": "scheme-light"
      }
    }
  ]
}
{% endschema %}
