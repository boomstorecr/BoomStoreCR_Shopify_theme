{%- liquid
  assign youtube_url = product.metafields.custom.youtube_video_url.value | default: product.metafields.custom.youtube_video_url
  assign video_id = youtube_url | split: 'v=' | last
  if youtube_url contains 'youtu.be/'
    assign video_id = youtube_url | split: 'youtu.be/' | last
  elsif youtube_url contains '/embed/'
    assign video_id = youtube_url | split: '/embed/' | last
  endif
  assign video_id = video_id | split: '&' | first | split: '?' | first
-%}

{%- if youtube_url != blank and video_id != blank -%}
  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }
    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}
  {{ 'video-section.css' | asset_url | stylesheet_tag }}
  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div class="video-section isolate page-width section-{{ section.id }}-padding">
      {%- if section.settings.heading != blank -%}
        <div class="title-wrapper title-wrapper--no-top-margin">
          <h2 class="title inline-richtext {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
        </div>
      {%- endif -%}
      <deferred-media
        class="video-section__media deferred-media gradient global-media-settings"
        data-media-id="{{ video_id }}"
        style="--ratio-percent: 56.25%;"
      >
        <button
          id="Deferred-Poster-Modal-{{ section.id }}"
          class="video-section__poster media deferred-media__poster media--landscape"
          type="button"
          aria-label="{{ 'sections.product_youtube_video.load_video' | t }}"
        >
          <span class="deferred-media__poster-button motion-reduce">
            <span class="svg-wrapper">{{- 'icon-play.svg' | inline_asset_content -}}</span>
          </span>
        </button>
        <template>
          <iframe
            src="https://www.youtube.com/embed/{{ video_id }}?autoplay=1&rel=0"
            class="js-youtube"
            allow="autoplay; encrypted-media"
            allowfullscreen
            title="{{ section.settings.heading | escape }}"
          ></iframe>
        </template>
      </deferred-media>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.product_youtube_video.name",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "t:sections.product_youtube_video.settings.heading.default",
      "label": "t:sections.product_youtube_video.settings.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "t:sections.all.heading_size.options__1.label" },
        { "value": "h1", "label": "t:sections.all.heading_size.options__2.label" }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "t:sections.all.colors.label"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36,
      "label": "t:sections.all.padding.padding_top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36,
      "label": "t:sections.all.padding.padding_bottom"
    }
  ],
  "presets": [{ "name": "t:sections.product_youtube_video.name" }]
}
{% endschema %}