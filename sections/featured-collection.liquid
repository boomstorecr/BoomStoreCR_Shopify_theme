{%- liquid
  assign display_mode = section.settings.display_mode | default: 'carousel'
  assign heading_alignment = section.settings.heading_alignment | default: 'center'
  assign heading_color = section.settings.heading_color
  assign button_url = section.settings.button_link
  if button_url == blank and section.settings.collection != blank
    assign button_url = section.settings.collection.url
  endif
-%}
<section class="featured-collection featured-collection--{{ display_mode }} color-{{ section.settings.color_scheme }} section-padding" data-section-id="{{ section.id }}" data-section-type="featured-collection">
  <div class="page-width">
    <div class="featured-collection__header featured-collection__header--{{ heading_alignment }}">
      {%- if section.settings.heading != blank -%}
        <h2 class="section-heading" id="featured-collection-{{ section.id }}" {% if heading_color != blank %}style="color: {{ heading_color }};"{% endif %}>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if display_mode == 'carousel' -%}
        <div class="carousel-nav">
          <button type="button" class="carousel-nav__button carousel-nav__button--prev" data-carousel-prev aria-label="{{ 'accessibility.previous_slide' | t }}">
            {%- render 'icon', icon: 'chevron-left' -%}
          </button>
          <button type="button" class="carousel-nav__button carousel-nav__button--next" data-carousel-next aria-label="{{ 'accessibility.next_slide' | t }}">
            {%- render 'icon', icon: 'chevron-right' -%}
          </button>
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.collection != blank -%}
      {%- if display_mode == 'carousel' -%}
        <div class="carousel" data-carousel aria-labelledby="featured-collection-{{ section.id }}">
          <ul class="carousel__track" data-carousel-track>
            {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
              <li class="carousel__slide">
                {%- render 'product-card', product: product, enable_quick_add: section.settings.enable_quick_add -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- else -%}
        <div class="featured-collection__grid" aria-labelledby="featured-collection-{{ section.id }}">
          {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
            {%- render 'product-card', product: product, enable_quick_add: section.settings.enable_quick_add -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.button_label != blank and button_url != blank -%}
        <div class="featured-collection__cta">
          <a href="{{ button_url }}" class="button button--primary">
            {{ section.settings.button_label }}
          </a>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.featured-collection.name",
  "settings": [
    { "type": "text", "id": "heading", "default": "Los más vendidos", "label": "t:sections.featured-collection.settings.heading.label" },
    { "type": "select", "id": "heading_alignment", "options": [
      { "value": "center", "label": "t:sections.featured-collection.settings.heading_alignment.options.center" },
      { "value": "right", "label": "t:sections.featured-collection.settings.heading_alignment.options.right" }
    ], "default": "center", "label": "t:sections.featured-collection.settings.heading_alignment.label" },
    { "type": "color", "id": "heading_color", "label": "t:sections.featured-collection.settings.heading_color.label", "info": "t:sections.featured-collection.settings.heading_color.info" },
    { "type": "collection", "id": "collection", "label": "t:sections.featured-collection.settings.collection.label" },
    { "type": "select", "id": "display_mode", "options": [
      { "value": "carousel", "label": "t:sections.featured-collection.settings.display_mode.options.carousel" },
      { "value": "grid", "label": "t:sections.featured-collection.settings.display_mode.options.grid" }
    ], "default": "carousel", "label": "t:sections.featured-collection.settings.display_mode.label" },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 16, "step": 1, "default": 8, "label": "t:sections.featured-collection.settings.products_to_show.label" },
    { "type": "checkbox", "id": "enable_quick_add", "default": true, "label": "t:sections.featured-collection.settings.enable_quick_add.label" },
    { "type": "text", "id": "button_label", "label": "t:sections.featured-collection.settings.button_label.label", "info": "t:sections.featured-collection.settings.button_label.info" },
    { "type": "url", "id": "button_link", "label": "t:sections.featured-collection.settings.button_link.label", "info": "t:sections.featured-collection.settings.button_link.info" },
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-light", "label": "t:sections.featured-collection.settings.color_scheme.label" }
  ],
  "presets": [
    {
      "name": "t:sections.featured-collection.presets.name",
      "settings": { "heading": "Los más vendidos", "display_mode": "carousel", "heading_alignment": "center", "products_to_show": 8, "enable_quick_add": true, "color_scheme": "scheme-light" }
    }
  ]
}
{% endschema %}
