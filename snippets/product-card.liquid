{%- liquid
  assign card_product = product
  assign variant = card_product.selected_or_first_available_variant
-%}
<a href="{{ card_product.url }}" class="product-card" data-product-card aria-label="{{ card_product.title | escape }}">
  <div class="product-card__media">
    {%- if card_product.featured_image -%}
      <img
        src="{{ card_product.featured_image | image_url: width: 600 }}"
        srcset="{{ card_product.featured_image | image_url: width: 300 }} 300w, {{ card_product.featured_image | image_url: width: 600 }} 600w"
        sizes="(min-width: 990px) 25vw, 50vw"
        alt="{{ card_product.featured_image.alt | default: card_product.title }}"
        loading="lazy"
        width="{{ card_product.featured_image.width }}"
        height="{{ card_product.featured_image.height }}"
        class="product-card__image product-card__image--primary"
      >
    {%- else -%}
      <div class="product-card__placeholder"></div>
    {%- endif -%}
    {%- if variant.compare_at_price > variant.price -%}
      <span class="badge badge--sale">{{ 'products.product.sale' | t }}</span>
    {%- elsif variant.available == false -%}
      <span class="badge badge--sold-out">{{ 'products.product.sold_out' | t }}</span>
    {%- endif -%}
  </div>
  <div class="product-card__info">
    {%- if card_product.vendor != blank -%}
      <p class="product-card__vendor">{{ card_product.vendor }}</p>
    {%- else -%}
      <p class="product-card__vendor product-card__vendor--empty" aria-hidden="true">&nbsp;</p>
    {%- endif -%}
    <h3 class="product-card__title">{{ card_product.title }}</h3>
    {%- render 'price', product: card_product, use_variant: true -%}

    {%- if enable_quick_add -%}
      <button
        type="button"
        class="button button--secondary product-card__quick-add"
        data-quick-add-button
        data-variant-id="{{ variant.id }}"
        {% if variant.available == false %}disabled{% endif %}
      >
        {%- if variant.available == false -%}
          {{ 'products.product.sold_out' | t }}
        {%- else -%}
          {{ 'products.product.quick_add' | t }}
        {%- endif -%}
      </button>
    {%- endif -%}
  </div>
</a>
