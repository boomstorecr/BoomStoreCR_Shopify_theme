{%- liquid
  assign deadline = section.settings.deadline
  assign deadline_timestamp = deadline | date: '%s'
  assign now_timestamp = 'now' | date: '%s'
  assign has_valid_deadline = false
  if deadline != blank and deadline_timestamp != blank
    assign has_valid_deadline = true
  endif
  assign should_render = false
  if has_valid_deadline and deadline_timestamp > now_timestamp
    assign should_render = true
  endif
  if request.design_mode
    assign should_render = true
  endif
-%}

{{ 'section-countdown.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-countdown.js' | asset_url }}" defer="defer"></script>

{%- if should_render -%}
  <section
    class="countdown color-{{ section.settings.color_scheme }}"
    data-section-id="{{ section.id }}"
    data-section-type="countdown"
    data-deadline="{{ deadline | escape }}"
    data-hidden="{% unless has_valid_deadline and deadline_timestamp > now_timestamp %}true{% else %}false{% endunless %}"
  >
    {%- if section.settings.image_desktop != blank -%}
      <div class="countdown__image-wrapper">
        <picture>
          {%- if section.settings.image_mobile != blank -%}
            <source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 1200 }}">
          {%- endif -%}
          {{ section.settings.image_desktop | image_url: width: 2400 | image_tag: class: 'countdown__image', loading: 'lazy', alt: '' }}
        </picture>
        <div class="countdown__overlay"></div>
      </div>
    {%- endif -%}
    <div class="countdown__content page-width">
      {%- if request.design_mode and has_valid_deadline == false -%}
        <p class="countdown__editor-hint">{{ 'sections.countdown.editor_hint' | t }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="countdown__heading">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<p class="countdown__subheading">{{ section.settings.subheading }}</p>{%- endif -%}
      {%- if has_valid_deadline and deadline_timestamp > now_timestamp -%}
        {%- assign countdown_units = 'days,hours,minutes,seconds' | split: ',' -%}
        <div class="countdown__timer" role="timer" aria-live="polite">
          {%- for unit in countdown_units -%}
            <div class="countdown__timer-unit">
              <span class="countdown__timer-value" data-unit="{{ unit }}">0</span>
              <span class="countdown__timer-label">{{ 'sections.countdown.units.' | append: unit | t }}</span>
            </div>
          {%- endfor -%}
          <span class="countdown__timer-sr"></span>
        </div>
      {%- endif -%}
      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a href="{{ section.settings.button_link }}" class="button countdown__button">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.countdown.name",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "deadline", "label": "t:sections.countdown.settings.deadline.label", "info": "t:sections.countdown.settings.deadline.info" },
    { "type": "image_picker", "id": "image_desktop", "label": "t:sections.countdown.settings.image_desktop.label" },
    { "type": "image_picker", "id": "image_mobile", "label": "t:sections.countdown.settings.image_mobile.label" },
    { "type": "text", "id": "heading", "label": "t:sections.countdown.settings.heading.label", "default": "t:sections.countdown.settings.heading.default" },
    { "type": "textarea", "id": "subheading", "label": "t:sections.countdown.settings.subheading.label" },
    { "type": "text", "id": "button_label", "label": "t:sections.countdown.settings.button_label.label" },
    { "type": "url", "id": "button_link", "label": "t:sections.countdown.settings.button_link.label" },
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-1", "label": "t:sections.all.colors.label" }
  ],
  "presets": [{ "name": "t:sections.countdown.name" }]
}
{% endschema %}