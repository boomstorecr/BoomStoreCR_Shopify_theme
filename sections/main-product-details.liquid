<section class="product-details" data-product-details id="ProductDetails">
  <div class="page-width product-details__grid">
    <div class="product-details__gallery" aria-label="{{ 'products.product.gallery_label' | t }}">
      <div class="product-details__media-stage">
        {%- if product.media.size > 0 -%}
          {%- assign gallery_media_started = false -%}
          {%- for media in product.media -%}
            {%- unless media.media_type == 'video' -%}
              {%- assign is_first_gallery_media = false -%}
              {%- if gallery_media_started == false -%}{%- assign is_first_gallery_media = true -%}{%- assign gallery_media_started = true -%}{%- endif -%}
              <div class="product-details__media{% unless media.id == product.featured_media.id or product.featured_media == blank and is_first_gallery_media or product.featured_media.media_type == 'video' and is_first_gallery_media %} is-hidden{% endunless %}" data-gallery-media data-media-id="{{ media.id }}">
                {%- case media.media_type -%}
                  {%- when 'image' -%}
                    <img src="{{ media | image_url: width: 1200 }}" srcset="{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 900 }} 900w, {{ media | image_url: width: 1200 }} 1200w" sizes="(min-width: 990px) 50vw, 100vw" alt="{{ media.alt | default: product.title | escape }}" width="{{ media.width }}" height="{{ media.height }}" loading="{% if is_first_gallery_media %}eager{% else %}lazy{% endif %}">
                  {%- else -%}
                    {{ media | media_tag: image_size: '1200x', controls: true, preload: 'metadata' }}
                {%- endcase -%}
              </div>
            {%- endunless -%}
          {%- endfor -%}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'product-details__placeholder' }}
        {%- endif -%}
      </div>

      {%- if product.media.size > 1 -%}
        <div class="product-details__thumbnails" role="list" aria-label="{{ 'products.product.gallery_thumbnails' | t }}">
          {%- for media in product.media -%}
            <button type="button" class="product-details__thumbnail" data-gallery-thumbnail data-media-id="{{ media.id }}" aria-label="{{ 'products.product.view_media' | t: number: forloop.index }}" aria-current="{% if media.id == product.featured_media.id or product.featured_media == blank and forloop.first %}true{% else %}false{% endif %}">
              {%- if media.preview_image -%}
                <img src="{{ media.preview_image | image_url: width: 180 }}" alt="{{ media.alt | default: product.title | escape }}" width="90" height="90" loading="lazy">
              {%- else -%}
                <span class="product-details__thumbnail-type">{{ media.media_type }}</span>
              {%- endif -%}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="product-details__information">
      <p class="product-details__eyebrow">{{ 'products.product.information' | t }}</p>
      <h2 class="product-details__title">{{ product.title }}</h2>
      <div class="product-details__facts">
        {%- if product.vendor != blank -%}<div class="product-details__fact"><span class="product-details__fact-icon">{% render 'icon', icon: 'store' %}</span><span><span class="product-details__fact-label">{{ 'products.product.facts.provider' | t }}</span><span class="product-details__fact-value">{{ product.vendor | escape }}</span></span></div>{%- endif -%}
        {%- assign fact = product.metafields.custom.cantidad_de_jugadores -%}
        {%- if fact != blank and fact.value != blank -%}{%- capture fact_value -%}{%- if fact.type contains 'list' -%}{%- assign has_value = false -%}{%- for value in fact.value -%}{%- if value != blank -%}{%- if has_value -%}, {% endif -%}{{ value | escape }}{%- assign has_value = true -%}{%- endif -%}{%- endfor -%}{%- else -%}{{ fact.value | escape }}{%- endif -%}{%- endcapture -%}{%- if fact_value != blank -%}<div class="product-details__fact"><span class="product-details__fact-icon">{% render 'icon', icon: 'people' %}</span><span><span class="product-details__fact-label">{{ 'products.product.facts.players' | t }}</span><span class="product-details__fact-value">{{ fact_value }}</span></span></div>{%- endif -%}{%- endif -%}
        {%- assign fact = product.metafields.custom.idioma -%}
        {%- if fact != blank and fact.value != blank -%}{%- capture fact_value -%}{%- if fact.type contains 'list' -%}{%- assign has_value = false -%}{%- for value in fact.value -%}{%- if value != blank -%}{%- if has_value -%}, {% endif -%}{{ value | escape }}{%- assign has_value = true -%}{%- endif -%}{%- endfor -%}{%- else -%}{{ fact.value | escape }}{%- endif -%}{%- endcapture -%}{%- if fact_value != blank -%}<div class="product-details__fact"><span class="product-details__fact-icon">{% render 'icon', icon: 'language' %}</span><span><span class="product-details__fact-label">{{ 'products.product.facts.language' | t }}</span><span class="product-details__fact-value">{{ fact_value }}</span></span></div>{%- endif -%}{%- endif -%}
        {%- assign fact = product.metafields.custom.tipo_de_juego -%}
        {%- if fact != blank and fact.value != blank -%}{%- capture fact_value -%}{%- if fact.type contains 'list' -%}{%- assign has_value = false -%}{%- for value in fact.value -%}{%- if value != blank -%}{%- if has_value -%}, {% endif -%}{{ value | escape }}{%- assign has_value = true -%}{%- endif -%}{%- endfor -%}{%- else -%}{{ fact.value | escape }}{%- endif -%}{%- endcapture -%}{%- if fact_value != blank -%}<div class="product-details__fact"><span class="product-details__fact-icon">{% render 'icon', icon: 'dice' %}</span><span><span class="product-details__fact-label">{{ 'products.product.facts.game_type' | t }}</span><span class="product-details__fact-value">{{ fact_value }}</span></span></div>{%- endif -%}{%- endif -%}
        {%- assign fact = product.metafields.custom.categorias -%}
        {%- if fact != blank and fact.value != blank -%}{%- capture fact_value -%}{%- if fact.type contains 'list' -%}{%- assign has_value = false -%}{%- for value in fact.value -%}{%- if value != blank -%}{%- if has_value -%}, {% endif -%}{{ value | escape }}{%- assign has_value = true -%}{%- endif -%}{%- endfor -%}{%- else -%}{{ fact.value | escape }}{%- endif -%}{%- endcapture -%}{%- if fact_value != blank -%}<div class="product-details__fact"><span class="product-details__fact-icon">{% render 'icon', icon: 'category' %}</span><span><span class="product-details__fact-label">{{ 'products.product.facts.categories' | t }}</span><span class="product-details__fact-value">{{ fact_value }}</span></span></div>{%- endif -%}{%- endif -%}
        {%- assign fact = product.metafields.custom.mecanicas_de_juego -%}
        {%- if fact != blank and fact.value != blank -%}{%- capture fact_value -%}{%- if fact.type contains 'list' -%}{%- assign has_value = false -%}{%- for value in fact.value -%}{%- if value != blank -%}{%- if has_value -%}, {% endif -%}{{ value | escape }}{%- assign has_value = true -%}{%- endif -%}{%- endfor -%}{%- else -%}{{ fact.value | escape }}{%- endif -%}{%- endcapture -%}{%- if fact_value != blank -%}<div class="product-details__fact"><span class="product-details__fact-icon">{% render 'icon', icon: 'mechanics' %}</span><span><span class="product-details__fact-label">{{ 'products.product.facts.mechanics' | t }}</span><span class="product-details__fact-value">{{ fact_value }}</span></span></div>{%- endif -%}{%- endif -%}
        {%- assign fact = product.metafields.custom.edad_minima -%}
        {%- if fact != blank and fact.value != blank -%}<div class="product-details__fact"><span class="product-details__fact-icon">{% render 'icon', icon: 'age' %}</span><span><span class="product-details__fact-label">{{ 'products.product.facts.minimum_age' | t }}</span><span class="product-details__fact-value">{{ fact.value }}</span></span></div>{%- endif -%}
        {%- assign fact = product.metafields.custom.minimo_de_jugadores -%}
        {%- if fact != blank and fact.value != blank -%}<div class="product-details__fact"><span class="product-details__fact-icon">{% render 'icon', icon: 'people' %}</span><span><span class="product-details__fact-label">{{ 'products.product.facts.minimum_players' | t }}</span><span class="product-details__fact-value">{{ fact.value }}</span></span></div>{%- endif -%}
        {%- assign fact = product.metafields.custom.disenador_del_juego -%}
        {%- if fact != blank and fact.value != blank -%}{%- capture fact_value -%}{%- if fact.type contains 'list' -%}{%- assign has_value = false -%}{%- for value in fact.value -%}{%- if value != blank -%}{%- if has_value -%}, {% endif -%}{{ value | escape }}{%- assign has_value = true -%}{%- endif -%}{%- endfor -%}{%- else -%}{{ fact.value | escape }}{%- endif -%}{%- endcapture -%}{%- if fact_value != blank -%}<div class="product-details__fact"><span class="product-details__fact-icon">{% render 'icon', icon: 'account' %}</span><span><span class="product-details__fact-label">{{ 'products.product.facts.designer' | t }}</span><span class="product-details__fact-value">{{ fact_value }}</span></span></div>{%- endif -%}{%- endif -%}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product details",
  "settings": [],
  "presets": [{ "name": "Product details" }]
}
{% endschema %}
